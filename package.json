{
  "name": "homebridge-owntone",
  "displayName": "Homebridge OwnTone",
  "version": "1.0.0",
  "description": "Homebridge dynamic platform plugin that exposes OwnTone (forked-daapd) servers as HomeKit Television-style media accessories.",
  "license": "Apache-2.0",
  "author": "homebridge-owntone contributors",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homebridge-owntone/homebridge-owntone.git"
  },
  "bugs": {
    "url": "https://github.com/homebridge-owntone/homebridge-owntone/issues"
  },
  "homepage": "https://github.com/homebridge-owntone/homebridge-owntone#readme",
  "keywords": [
    "homebridge-plugin",
    "owntone",
    "forked-daapd",
    "daapd",
    "airplay",
    "music",
    "homekit",
    "television"
  ],
  "engines": {
    "node": "^20.18.1 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.6.0 || ^2.0.0-beta.0"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm run build && npm test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^1.0.3",
    "undici": "^7.16.0"
  },
  "peerDependencies": {
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.9",
    "eslint": "^9.39.1",
    "hap-nodejs": "^0.14.3",
    "homebridge": "^1.11.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
